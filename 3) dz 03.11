a = float(input())
b = float(input())
h = float(input())
n = int(input())
x = a
while x <= b + 0.00001:
    if x == 0:
        print("x =", round(x, 2), "деление на ноль")
    else:
        p = 1
        st5 = 25  # 5^(2*1)
        st3 = 3  # 3^(2*1 - 1)
        for i in range(1, n + 1):
            chislit = (st5 - st3) * x
            znam = (2 * i) ** 0.5
            p = p * (chislit / znam)
            st5 = st5 * 25
            st3 = st3 * 9
        print("x", round(x, 2), "P", p)
    x = x + h
