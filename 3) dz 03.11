a = float(input())
b = float(input())
h = float(input())
n = int(input())
eps = 1e-12
x = a
while x <= b + eps:
    if x == 0:
        print("x =", round(x, 2), "деление на ноль")
    else:
        p = 1
        st5 = 25  # 5^(2*1)
        st3 = 3  # 3^(2*1 - 1)

        for i in range(1, n + 1):
            chislitel = (st5 - st3) * x
            znamenatel = (2 * i) ** 0.5

            p = p * (chislitel / znamenatel)

            st5 = st5 * 25
            st3 = st3 * 9

        print("x =", round(x, 2), "P =", p)

    x = x + h
