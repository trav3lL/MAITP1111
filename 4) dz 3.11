from math import log

a = float(input())
b = float(input())
h = float(input())
eps = float(input())
x = a
while x <= b + 0.00001:
    if x <= -1 or x == 0:
        print("x", round(x, 2), "Не входит в ОДЗ")
    else:
        sla = log(x + 1)
        s = slag
        n = 1
        while abs(slag) > eps:
            slag = slag / (2 * n * (2 * n + 1) * x)
            s = s + slag
            n = n + 1
            if n > 5000:
                break
        print("x", round(x, 2), "sum", round(s, 6))
    x = x + h
